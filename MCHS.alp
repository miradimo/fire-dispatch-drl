					<Properties Source="1772027854175" Target="1772027856703" Trigger="arrival">
						<Action><![CDATA[double travel_time = time(MINUTE) - tripStartTime;
if (main.control_mode == 0) { 
    try {
        java.io.FileWriter fw = new java.io.FileWriter("greedy_high.csv", true);
        java.io.BufferedWriter bw = new java.io.BufferedWriter(fw);
        java.io.PrintWriter out = new java.io.PrintWriter(bw);
        
        out.println(this.fireId + "," + travel_time);
        
        out.close();
        bw.close();
        fw.close();
        
        traceln("[JAVA LOG] Записан инцидент " + this.fireId + " | Время: " + travel_time);
    } catch (java.io.IOException e) {
        traceln("[ERROR] Не удалось записать лог Жадного алгоритма: " + e.getMessage());
    }
}

main.responseTimeData.add(travel_time);
traceln("Машина " + this.getIndex() + " прибыла. Время в пути: " + travel_time + " мин.");

((Main)get_Main()).py.run("update_reward(" + this.fireId + ", " + travel_time + ")");]]></Action>
