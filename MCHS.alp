					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[3]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MINUTE]]></Unit>
						</Rate>
						<Id>1773132396753</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1772092800000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if (waiting_for_operator) {
    return;
}

java.util.ArrayList<FireTruck> reservedThisMinute = new java.util.ArrayList<>();

for (GISPoint pt : fireLocations) {
    if (!activeFires.contains(pt) && randomTrue(firerate)) {
        
        activeFires.add(pt); 
        int currentFireId = pt.hashCode();
        FireMarker icon = add_fireIcons(); 
		icon.setLocation(pt);               
		icon.myPoint = pt;                 
        int severity = randomTrue(0.8) ? 1 : 2; 
        
        FireTruck selectedTruck = null;
        int chosen_station_index = -1;

        // =================================================================
        // РЕЖИМ 0
        // =================================================================
        if (control_mode == 0) {
            double minDistance = Double.MAX_VALUE;
            
            for (int i = 0; i < allStations.size(); i++) {
                double dist = allStations.get(i).distance(pt);
                boolean hasFreeTruck = false;
                
                for (FireTruck truck : fireTrucks) {
                     if (!truck.working && !reservedThisMinute.contains(truck) && truck.homeBase == allStations.get(i)) {
                         hasFreeTruck = true;
                         break;
                     }
                }
                
                if (hasFreeTruck && dist < minDistance) {
                    minDistance = dist;
                    chosen_station_index = i;
                }
            }
            
            if (chosen_station_index != -1) {
                for (FireTruck truck : fireTrucks) {
                    if (!truck.working && !reservedThisMinute.contains(truck) && truck.homeBase == allStations.get(chosen_station_index)) {
                        selectedTruck = truck;
                        break; 
                    }
                }
            }

        // =================================================================
        // РЕЖИМЫ 1 и 2
        // =================================================================
        } else {
            int numStations = allStations.size();
            double[] distances = new double[numStations];
            int[][] stationStatus = new int[numStations][2];
            
            for (int i = 0; i < numStations; i++) {
                distances[i] = allStations.get(i).distance(pt);
                int countTanker = 0;
                int countLadder = 0;
                for (FireTruck truck : fireTrucks) {
                    if (!truck.working && !reservedThisMinute.contains(truck) && truck.homeBase == allStations.get(i)) {
                        if (truck.type == TANKER) countTanker++;
                        else if (truck.type == LADDER) countLadder++;
                    }
                }
                stationStatus[i][0] = countTanker; 
                stationStatus[i][1] = countLadder; 
            }
            
            String strDist = java.util.Arrays.toString(distances);
            String strStatus = java.util.Arrays.deepToString(stationStatus);
            
            String pyCall = "get_action(" + currentFireId + ", " + severity + ", " + strDist + ", " + strStatus + ")";
            chosen_station_index = py.runResults(int.class, pyCall);
            
            ai_recommendation = chosen_station_index;
            
            if (control_mode == 2) {
                
                pending_fire_pt = pt;
                pending_fire_id = currentFireId;
                pending_severity = severity;
                waiting_for_operator = true;
                
                if (chosen_station_index != -1) {
                    if (current_preview_route != null) {
                        map.remove(current_preview_route); 
                    }
                    current_preview_route = map.getRoute(
                        allStations.get(chosen_station_index).getLatitude(),
                        allStations.get(chosen_station_index).getLongitude(),
                        pt.getLatitude(),
                        pt.getLongitude()
                    );
                    current_preview_route.setLineColor(lime); 
                    current_preview_route.setLineWidth(4);    
                }
                // ==========================================================
                
                traceln("[СППР] Инцидент " + currentFireId + ". ИИ предлагает Депо #" + chosen_station_index + ". Ждем реакции диспетчера...");
                icon.visible = true;
                getEngine().pause(); 
                break; 
            }
            
             
            if (chosen_station_index != -1) {
                for (FireTruck truck : fireTrucks) {
                    if (!truck.working && !reservedThisMinute.contains(truck) && truck.homeBase == allStations.get(chosen_station_index)) {
                        if ((severity == 1 && truck.type == TANKER) || 
                            (severity == 2 && truck.type == LADDER)) {
                            selectedTruck = truck;
                            break; 
                        }
                    }
                }
            } else {
                traceln("[ANYLOGIC] ИИ сообщил: нет свободных машин для пожара типа " + severity + "! Вызов отменен.");
            }
        }

        if (selectedTruck != null) {
            reservedThisMinute.add(selectedTruck); 
            send(pt, selectedTruck); 
            selectedTruck.tripStartTime = time();
            selectedTruck.fireId = currentFireId; 
            
            if (selectedTruck.currentRoute != null) {
                map.remove(selectedTruck.currentRoute);
            }
            selectedTruck.currentRoute = map.getRoute(
                allStations.get(chosen_station_index).getLatitude(),
                allStations.get(chosen_station_index).getLongitude(),
                pt.getLatitude(),
                pt.getLongitude()
            );
            
            selectedTruck.currentRoute.setLineColor(selectedTruck.type == TANKER ? red : blue);
            selectedTruck.currentRoute.setLineWidth(3);
            
            
            String modeStr = (control_mode == 1) ? "[ИИ-АВТОПИЛОТ]" : "[СТАНДАРТ]";
            traceln(modeStr + " Станция #" + chosen_station_index + " -> пожар " + currentFireId + " (Сложность: " + severity + ")");
        } else {
            activeFires.remove(pt);
        }
    }
}]]></Action>
				</Event>
				<Event>
					<Id>1779627196107</Id>
					<Name><![CDATA[metricsUpdater]]></Name>
					<X>620</X><Y>-140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1779627196105</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1779696000000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[
if (userRole == 2 && ai_mode == true) {
    
    
    String metricsStr = py.runResults(String.class, "get_metrics()");
    
    if (metricsStr != null && metricsStr.contains(",")) {
        String[] parts = metricsStr.split(",");
        double lossVal = Double.parseDouble(parts[0]);
        double epsVal = Double.parseDouble(parts[1]);
        double rewVal = Double.parseDouble(parts[2]);
        
        
        lossData.add(lossVal);
        epsilonData.add(epsVal);
        rewardData.add(rewVal);
    }
}]]></Action>
				</Event>
				<Event>
					<Id>1780341792778</Id>
					<Name><![CDATA[disptexttimer]]></Name>
					<X>1000</X><Y>-270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1780341792776</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1780387200000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[String text = "Статус пожарных станций:\n\n";


for (int i = 0; i < allStations.size(); i++) { 
    

    GISPoint currentPoint = allStations.get(i); 
    

    int freeTankers = count(fireTrucks, truck -> 
        truck.homeBase == currentPoint && 
        truck.type == TANKER && 
        !truck.working
    );
    

    int freeLadders = count(fireTrucks, truck -> 
        truck.homeBase == currentPoint && 
        truck.type == LADDER && 
        !truck.working
    );
    

    text += "Депо " + (i + 1) + ": АЦ - " + freeTankers + " шт. | АЛ - " + freeLadders + " шт.\n";
}


disptext = text;]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1780343835658</Id>
					<Name><![CDATA[operatorDispatch]]></Name>
					<X>1160</X><Y>-320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[stationIndex]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[FireTruck selectedTruck = null;


for (FireTruck truck : fireTrucks) {
    if (!truck.working && truck.homeBase == allStations.get(stationIndex)) {
        if ((pending_severity == 1 && truck.type == TANKER) || 
            (pending_severity == 2 && truck.type == LADDER)) {
            selectedTruck = truck;
            break; 
        }
    }
}


if (selectedTruck == null) {
    for (FireTruck truck : fireTrucks) {
        if (!truck.working && truck.homeBase == allStations.get(stationIndex)) {
            selectedTruck = truck;
            break;
        }
    }
}


if (selectedTruck != null) {
    send(pending_fire_pt, selectedTruck); 
    selectedTruck.tripStartTime = time();
    selectedTruck.fireId = pending_fire_id; 
    

    if (current_preview_route != null) {
        if (stationIndex == ai_recommendation) {
         
            selectedTruck.currentRoute = current_preview_route;
            selectedTruck.currentRoute.setLineColor(selectedTruck.type == TANKER ? red : blue);
            selectedTruck.currentRoute.setLineWidth(3);
            
            current_preview_route = null; 
        } else {

            map.remove(current_preview_route);
            current_preview_route = null;
            

            selectedTruck.currentRoute = map.getRoute(
                allStations.get(stationIndex).getLatitude(),
                allStations.get(stationIndex).getLongitude(),
                pending_fire_pt.getLatitude(),
                pending_fire_pt.getLongitude()
            );
            selectedTruck.currentRoute.setLineColor(selectedTruck.type == TANKER ? red : blue);
            selectedTruck.currentRoute.setLineWidth(3);
        }
    } else {
        selectedTruck.currentRoute = map.getRoute(
            allStations.get(stationIndex).getLatitude(),
            allStations.get(stationIndex).getLongitude(),
            pending_fire_pt.getLatitude(),
            pending_fire_pt.getLongitude()
        );
        selectedTruck.currentRoute.setLineColor(selectedTruck.type == TANKER ? red : blue);
        selectedTruck.currentRoute.setLineWidth(3);
    }
    // =================================================================
    
    traceln("[СППР ПЕРЕХВАТ] Диспетчер выбрал Станцию #" + stationIndex + " (ИИ советовал #" + ai_recommendation + ") -> пожар " + pending_fire_id);
} else {
    traceln("[ОШИБКА] На выбранной Станции #" + stationIndex + " нет свободной техники! Вызов сорван.");
    activeFires.remove(pending_fire_pt); 
    

    if (current_preview_route != null) {
        map.remove(current_preview_route);
        current_preview_route = null;
    }
}


waiting_for_operator = false;
getEngine().run(); ]]></Body>
				</Function>
