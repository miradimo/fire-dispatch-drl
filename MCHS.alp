						<Action><![CDATA[for (FireMarker icon : main.fireIcons) {
    if (icon.myPoint == this.targetFire) {
    	icon.visible = false;
        main.remove_fireIcons(icon);
        break;
    }
}
if (currentRoute != null) {
    main.map.remove(currentRoute); 
    currentRoute = null;           
}
((Main)get_Main()).activeFires.remove(this.targetFire);


this.moveTo(this.homeBase);]]></Action>
