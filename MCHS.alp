			<ActionField>
				<Name><![CDATA[ai_action]]></Name>
				<Type><![CDATA[int]]></Type>
			</ActionField>
			<ActionCode><![CDATA[if (ai_action != -1 && root.current_fire != null) {
    FireTruck aiTruck = root.fireTrucks.get(ai_action);
    if (aiTruck.inState(FireTruck.Idle)) {
        root.send(root.current_fire, aiTruck);
        traceln("Python: отправлена машина №" + ai_action);
    }
    
    // ОЧИЩАЕМ ПАМЯТЬ:
    root.activeFires.remove(root.current_fire); // <--- Добавьте это!
    root.current_fire = null; 
}

root.obs_fire_X = 0.0;
root.obs_fire_Y = 0.0;]]></ActionCode>
