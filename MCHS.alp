						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[this.setSpeed(main.truckspeed, KPH); 	
for (GISRegion jz : main.jamZones) {
    if (jz.contains(this.getLatitude(), this.getLongitude())) {    
        this.setSpeed(main.truckspeed / main.jamrate, KPH);
        break; 
    }
}]]></Action>
